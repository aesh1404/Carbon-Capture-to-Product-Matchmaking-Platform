OPENROUTE_API_KEY=your_key_here

# Local Postgres. Prefer gitignored application-secret.properties for the password.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carbonlink
SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=

# Render / Neon / Supabase style URL. When set, it overrides the SPRING_DATASOURCE_* values.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/carbonlink
